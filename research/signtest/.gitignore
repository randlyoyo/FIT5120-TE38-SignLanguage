# Datasets and everything derived from them. The corpus alone is 33 GB and the
# extracted keypoints another 10; all of it is reproducible from extract.py and
# extract3d.py given the source zips, so none of it belongs in history.
MM-WLAuslan/
keypoints/
keypoints3d/
cache/
cache3d/
cache_noar/
scores/
scores_noar/
export/
checks/
runs/
logs/
venv/
__pycache__/
*.pyc

# Build outputs. Regenerate with batch_build.py, export_gltf.py,
# batch_compare.py and contact_sheets.py.
renders/anim/
renders/glb_mixamo/
renders/compare/
renders/src/
renders/sheets/
renders/*.gif
renders/*.png
renders/*.npz

# Kept on purpose: the small artefacts that describe a build rather than
# being one -- the rig, the manifest, the take scores and the render check.
!renders/rig.json
!renders/manifest.json
!renders/joint_names.json
!renders/render_check.json

# takes.json is 19 MB of per-take scores for all 64,300 recordings. Useful, but
# regenerated by select_takes.py in three minutes.
renders/takes.json

FIT5120-TE38-SignLanguage-master/
FIT5120-TE38-SignLanguage-master.zip
signbank_description/
*.task
.DS_Store

# Third-party corpora, model code and weights, added to this workspace
# separately. Auslan-Daily alone is 27 GB.
Auslan-Daily/
Uni-Sign/
checkpoints/
data/
signtest/
*.mp4
*.pth
renders/rt_*.json
