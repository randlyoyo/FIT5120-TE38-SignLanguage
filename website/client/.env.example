VITE_API_BASE_URL=/api
# Sign-chat backend (sign_chat/sign_chat_backend) -- runs on a separate GPU
# host, not this site's own server. Mock mode: `SIGNCHAT_MOCK=1 uvicorn
# signchat.server:app --port 8000`, then VITE_SIGNCHAT_API_BASE_URL=http://localhost:8000
VITE_SIGNCHAT_API_BASE_URL=http://localhost:8000
# 3D avatar rig (see AVATAR_SETUP.md). Unset = falls back to playing the
# backend's rendered video instead.
# VITE_AVATAR_MODEL_URL=/avatar.vrm
